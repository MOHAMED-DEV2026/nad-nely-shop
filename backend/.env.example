# Copier ce fichier en « .env » puis remplir les valeurs (le fichier .env ne va jamais sur GitHub).

# Serveur
PORT=3000
FRONT_URL=http://localhost:5173

# Base de données MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nadnely_shop

# Jeton de connexion : une longue phrase secrète au hasard (obligatoire)
JWT_SECRET=changer-cette-phrase-par-une-longue-valeur-secrete
JWT_EXPIRES_IN=2h
# Durée de la connexion quand le client coche « Se souvenir de moi »
JWT_EXPIRES_IN_SOUVENIR=30d

# Paiement Stripe (mode test) : clé secrète qui commence par sk_test_
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# E-mails de test Mailtrap (codes de vérification et de réinitialisation), utilisés si SMTP_HOST est vide
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=

# E-mails réels (production) : si SMTP_HOST est rempli, il remplace Mailtrap.
# Envoi par Resend (https://resend.com) : le domaine nad-nelyshop.yt doit être vérifié dans Resend.
# SMTP_USER vaut toujours « resend » ; SMTP_PASS est la clé API Resend (commence par re_).
# SMTP_FROM doit utiliser une adresse du domaine vérifié.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxx
SMTP_FROM='"NAD-NELY Shop" <no-reply@nad-nelyshop.yt>'

# Adresse de la boutique : reçoit les alertes (nouvelle commande, stock bas, remboursement)
# et les messages du formulaire de contact. Resend ne reçoit pas d'e-mails : mettre la boîte OVH.
ADMIN_EMAIL=contact@nad-nelyshop.yt
# Alerte « stock bas » quand un produit passe à ce stock ou moins après une commande
SEUIL_STOCK_BAS=3
# Logo affiché en haut des e-mails (doit être une adresse en ligne)
EMAIL_LOGO_URL=https://nad-nely.alwaysdata.net/logo.png

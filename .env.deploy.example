# Copier ce fichier en « .env.deploy » (non versionné) pour que « npm run deploy » redémarre le site Node.
# Jeton : panneau alwaysdata → Profil → Jetons d'API → Créer un jeton
ALWAYSDATA_API_TOKEN=
# Numéro du site Node (/api) : dans l'adresse admin.alwaysdata.com/site/XXXXXXX/ quand on ouvre ce site
ALWAYSDATA_SITE_ID_API=
